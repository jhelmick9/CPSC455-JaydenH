<%- include('../Partials/header') %>

<div class="main">
  <h2>Create a New Trade Item</h2>

  <form action="/trades" method="post" class="trade-form">
    <label>Item Name<br>
      <input name="name" required>
    </label>

    <label>Catigories<br>
      <input name="category" placeholder="modern" required>
    </label>

    <label>Details<br>
      <textarea name="details" rows="3" required></textarea>
    </label>

    <label>Team<br>
      <input name="team">
    </label>

    <label>Year<br>
      <input name="year" type="number" min="1800" max="2100">
    </label>

    <label>Grade<br>
      <input name="grade" placeholder="1-10">
    </label>

    <label>Image URL<br>
      <input name="image" value="/Picture/image.png">
    </label>

    <label>Status<br>
      <input name="status" value="Available">
    </label>

    <button type="submit" class="btn">Create Item</button>
  </form>
</div>

<%- include('../Partials/footer') %>
