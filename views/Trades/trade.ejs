<%- include('../Partials/header') %>

<div class="trade_main">
  <div>
    <h2><%= item.name %></h2>
    <h3>Catigories: <%= item.category %></h3>
  </div>

  <div class="nested">
    <img src="<%= item.image %>" alt="<%= item.name %>">
  </div>

  <div>
    <h3>Details</h3>
    <p><b>Description:</b> <%= item.details %></p>
    <p><b>Team:</b> <%= item.team || 'N/A' %></p>
    <p><b>Year:</b> <%= item.year || 'N/A' %></p>
    <p><b>Grade:</b> <%= item.condition || 'N/A' %></p>
    <p><b>Status:</b> <%= item.status %></p>

    <% if (isLoggedIn && !isOwner) { %>
      <form action="/trades/<%= item.id %>/favorite" method="post" style="margin-top: 12px;">
        <button type="submit" class="btn">Add to Favorites</button>
      </form>
    <% } %>
  </div>

  <% if (isOwner) { %>
    <div class="updateButtons">
      <a class="editButton" href="/trades/<%= item.id %>/edit">Update</a>
      <form action="/trades/<%= item.id %>/delete" method="post" class="inline-form" onsubmit="return confirm('Delete this item?');">
        <button class="deleteButton" type="submit">Delete</button>
      </form>
    </div>
  <% } %>
    <% if (isLoggedIn) { %>
      <% if (!isOwner) { %>
        <a class="tradeButton" href="/trades/<%= item.id %>/new">Trade</a>
      <% } %>
    <% } %>
</div>

<%- include('../Partials/footer') %>
