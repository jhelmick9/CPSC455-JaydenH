<%- include('../Partials/header') %>

<div class="main">
  <h2>Available Trades</h2>
  <p>Browse baseball cards by catigories.</p>
  <% if (isLoggedIn) { %>
    <p><a href="/trades/new">Create New Item</a></p>
  <% } %>

  <% const topicList = topics || [...new Set(items.map((item) => item.category))]; %>

  <% if (topicList.length === 0) { %>
    <p>No items are currently available.</p>
  <% } %>

  <% topicList.forEach((topic) => { %>
    <section class="category">
      <h3><%= topic %></h3>

      <% items.forEach((item) => { %>
        <% if (item.category === topic) { %>
          <div class="trade-item">
            <a href="/trades/<%= item.id %>"><%= item.name %></a>
            <p>Catigories: <%= item.category %></p>
            <p>Team: <%= item.team || 'N/A' %> | Year: <%= item.year || 'N/A' %> | Status: <%= item.status %></p>
          </div>
        <% } %>
      <% }) %>
    </section>
  <% }) %>
</div>

<%- include('../Partials/footer') %>
