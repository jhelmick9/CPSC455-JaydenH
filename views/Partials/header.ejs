<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Card Locker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="header">
    <div class="header-inner">
      <img src="/Picture/image.png" alt="The Card Locker logo">
      <h1>The Card Locker</h1>
    </div>
  </div>

  <div class="nav">
    <a href="/">Home</a>
    <a href="/trades">Trades</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <% if (isLoggedIn) { %>
      <span class="welcome-message">Welcome, <%= user.name %></span>
      <a href="/trades/new">New Trade</a>
      <a href="/users/profile">Profile</a>
      <a href="/users/signout" class="login-link">Logout</a>
    <% } else { %>
      <a href="/signup">Sign Up</a>
      <a href="/login" class="login-link">Login</a>
    <% } %>
  </div>

  <% if (errorMessages && errorMessages.length) { %>
    <div class="flash-wrap">
      <% errorMessages.forEach((message) => { %>
        <div class="flash flash-error"><%= message %></div>
      <% }) %>
    </div>
  <% } %>

  <% if (successMessages && successMessages.length) { %>
    <div class="flash-wrap">
      <% successMessages.forEach((message) => { %>
        <div class="flash flash-success"><%= message %></div>
      <% }) %>
    </div>
  <% } %>
